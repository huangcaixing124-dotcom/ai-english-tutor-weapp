<!-- 可点击单词的英文内容 -->
<wxs module="wordUtil">
  function isWordToken(t) { return t.isWord; }
</wxs>

<!-- 主页面 -->
<view class="page-container">
  <!-- 顶部安全区 + 标题 -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-inner">
      <text class="header-title">AI English Tutor</text>
      <text class="header-subtitle">Your personal speaking coach</text>
    </view>
  </view>

  <!-- 场景/难度选择 -->
  <view class="selector-section">
    <view class="selector-row">
      <picker mode="selector" range="{{scenarioNames}}" value="{{currentScenarioIndex}}"
        bindchange="onScenarioChange" class="picker-selector">
        <view class="picker-label">
          <text class="picker-label-text">Scenario</text>
          <text class="picker-value">{{scenarios[currentScenarioIndex].label}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
      <picker mode="selector" range="{{difficultyNames}}" value="{{currentDifficultyIndex}}"
        bindchange="onDifficultyChange" class="picker-selector">
        <view class="picker-label">
          <text class="picker-label-text">Level</text>
          <text class="picker-value">{{difficulties[currentDifficultyIndex].label}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 模式切换 -->
  <view class="mode-switch">
    <view class="mode-switch-inner">
      <view class="mode-tab {{conversationMode === 'press' ? 'active' : ''}}" data-mode="press" bindtap="switchMode">
        <text class="mode-tab-icon">🔴</text>
        <text class="mode-tab-text">按说</text>
      </view>
      <view class="mode-tab {{conversationMode === 'call' ? 'active' : ''}}" data-mode="call" bindtap="switchMode">
        <text class="mode-tab-icon">📞</text>
        <text class="mode-tab-text">通话</text>
      </view>
    </view>
  </view>

  <!-- 氛围光背景 -->
  <view class="ambient-bg" style="{{ambientStyle}}"></view>

  <!-- 对话展示区 -->
  <scroll-view class="conversation-section" scroll-y="true" scroll-with-animation="true"
    scroll-into-view="{{scrollTarget}}">
    <view class="conversation-list">
      <!-- 对话历史（遍历展示） -->
      <block wx:for="{{displayTurns}}" wx:key="index">
        <view class="slide-up">
          <!-- 用户语音消息 -->
          <block wx:if="{{item.isVoice}}">
            <view class="bubble-group" style="margin-top: 12rpx; align-items: flex-end;">
              <view class="bubble-user-voice-wrap">
                <text class="voice-time">{{item.userDurationText || '0:03'}}</text>
                <view class="bubble-user-voice {{activeUserVoiceIndex === index ? 'playing' : ''}}" bindtap="onPlayUserVoice" data-turn-index="{{index}}">
                  <view class="voice-wave-bars">
                    <view class="wave-bar wave-bar-1" />
                    <view class="wave-bar wave-bar-2" />
                    <view class="wave-bar wave-bar-3" />
                  </view>
                </view>
              </view>
            </view>
          </block>
          <!-- 用户文字消息 -->
          <block wx:else>
            <view class="bubble-user">
              <text class="bubble-user-text">{{item.user}}</text>
            </view>
          </block>
          <!-- AI 语音回复 → 文字展示 + 播放按钮 -->
          <block wx:if="{{item.isVoice && !item.isPending}}">
            <view class="bubble-group" style="margin-top: 12rpx;">
              <view class="bubble bubble-ai">
              <view class="bubble-body">
                <view class="bubble-label-row">
                  <text class="bubble-label bubble-label-english">ENGLISH <text class="word-hint">(tap words)</text></text>
                    <view class="replay-btn" bindtap="playVoiceMessage" data-turn-index="{{index}}">
                      <text class="replay-icon">🔊</text>
                    </view>
                  </view>
                  <view class="word-container">
                    <block wx:for="{{item.tokens}}" wx:key="index" wx:for-item="word">
                      <text wx:if="{{word.isWord}}" class="word-tappable" data-word="{{word.text}}" bindtap="onWordTap">{{word.text}}</text>
                      <text wx:else class="word-punct">{{word.text}}</text>
                    </block>
                  </view>
                </view>
              </view>
              <view class="bubble bubble-ai">
                <view class="bubble-body">
                  <text class="bubble-label bubble-label-translate">翻译</text>
                  <text class="bubble-text bubble-text-secondary">{{item.ai.chinese}}</text>
                </view>
              </view>
              <view class="bubble bubble-ai bubble-correction" wx:if="{{item.ai.correction}}">
                <view class="bubble-body">
                  <text class="bubble-label bubble-label-orange">TIP</text>
                  <text class="bubble-text bubble-text-secondary">{{item.ai.correction}}</text>
                </view>
              </view>
            </view>
          </block>
          <!-- AI 加载中 -->
          <block wx:elif="{{item.isVoice && item.isPending}}">
            <view class="bubble-ai-loading">
              <view class="loading-dots">
                <view class="dot dot-1" />
                <view class="dot dot-2" />
                <view class="dot dot-3" />
              </view>
            </view>
          </block>
          <!-- AI 文字回复（兼容旧数据） -->
          <block wx:else>
            <view class="bubble-group" style="margin-top: 12rpx;">
              <view class="bubble bubble-ai">
              <view class="bubble-body">
                <view class="bubble-label-row">
                  <text class="bubble-label bubble-label-english">ENGLISH <text class="word-hint">(tap words)</text></text>
                    <view class="replay-btn" wx:if="{{item.aiAudioPath}}" bindtap="playVoiceMessage" data-turn-index="{{index}}">
                      <text class="replay-icon">🔊</text>
                    </view>
                  </view>
                  <view class="word-container">
                    <block wx:for="{{item.tokens}}" wx:key="index" wx:for-item="word">
                      <text wx:if="{{word.isWord}}" class="word-tappable" data-word="{{word.text}}" bindtap="onWordTap">{{word.text}}</text>
                      <text wx:else class="word-punct">{{word.text}}</text>
                    </block>
                  </view>
                </view>
              </view>
              <view class="bubble bubble-ai">
                <view class="bubble-body">
                  <text class="bubble-label bubble-label-translate">翻译</text>
                  <text class="bubble-text bubble-text-secondary">{{item.ai.chinese}}</text>
                </view>
              </view>
              <view class="bubble bubble-ai bubble-correction" wx:if="{{item.ai.correction}}">
                <view class="bubble-body">
                  <text class="bubble-label bubble-label-orange">TIP</text>
                  <text class="bubble-text bubble-text-secondary">{{item.ai.correction}}</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </block>

      <!-- 欢迎语（无对话时展示） -->
      <block wx:if="{{showWelcome && displayTurns.length === 0}}">
        <view class="slide-up">
          <view class="bubble-group">
            <view class="bubble bubble-ai">
              <view class="bubble-body">
                <text class="bubble-label bubble-label-english">ENGLISH <text class="word-hint">(tap words)</text></text>
                <view class="word-container">
                  <block wx:for="{{wordTokens}}" wx:key="index">
                    <text wx:if="{{item.isWord}}" class="word-tappable" data-word="{{item.text}}" bindtap="onWordTap">{{item.text}}</text>
                    <text wx:else class="word-punct">{{item.text}}</text>
                  </block>
                </view>
              </view>
            </view>
            <view class="bubble bubble-ai">
              <view class="bubble-body">
                <text class="bubble-label bubble-label-translate">翻译</text>
                <text class="bubble-text bubble-text-secondary">{{scenarios[currentScenarioIndex].welcomeChinese}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <view id="conversation-bottom" />
    </view>
  </scroll-view>

  <!-- 底部输入区域 -->
  <view class="footer">
    <!-- 错误提示 -->
    <view class="error-tip" wx:if="{{error}}">
      <text>{{error}}</text>
    </view>

    <!-- 按说模式 -->
    <block wx:if="{{conversationMode === 'press'}}">
      <!-- 语音录制声波动画 -->
      <view class="voice-indicator {{isRecording ? 'active' : ''}}">
        <view class="voice-bar" wx:for="{{recordBarHeights}}" wx:key="index"
          style="background: var(--apple-red);" />
      </view>

      <!-- 语音录制按钮 -->
      <view class="voice-input-group {{isLoading || isSpeaking ? 'disabled' : ''}}">
        <button class="record-button {{isRecording ? 'recording' : ''}}"
          bindtap="onToggleRecord" disabled="{{isLoading || isSpeaking}}">
          <view class="record-icon-wrap">
            <view wx:if="{{!isRecording}}" class="mic-icon">
              <view class="mic-body"></view>
              <view class="mic-stem"></view>
              <view class="mic-base"></view>
            </view>
            <view wx:else class="recording-icon">
              <view class="recording-dot"></view>
            </view>
          </view>
        </button>
        <text class="record-hint">{{isRecording ? 'Release to send' : 'Tap to speak'}}</text>
      </view>

      <!-- 加载/说话提示 -->
      <text class="footer-hint" wx:if="{{isLoading}}">Thinking...</text>
      <text class="footer-hint" wx:elif="{{isSpeaking}}">Speaking...</text>
    </block>

    <!-- 通话模式 -->
    <block wx:else>
      <block wx:if="{{!isCallActive}}">
        <!-- 未通话 -->
        <view class="call-start-area">
          <button class="call-start-button" bindtap="startCall">
            <view class="call-icon">
              <view class="call-icon-handset"></view>
              <view class="call-icon-base"></view>
            </view>
          </button>
          <text class="record-hint">Start a call conversation</text>
        </view>
      </block>
      <block wx:else>
        <!-- 通话中 -->
        <view class="call-active-area">
          <view class="call-status-label {{callStatus}}">
            <text wx:if="{{callStatus === 'listening'}}">Listening...</text>
            <text wx:elif="{{callStatus === 'processing'}}">Thinking...</text>
            <text wx:elif="{{callStatus === 'speaking'}}">Speaking...</text>
          </view>
          <button class="call-end-button" bindtap="endCall">
            <view class="call-end-icon">
              <view class="end-square"></view>
            </view>
          </button>
          <text class="record-hint">Tap to end call</text>
        </view>
      </block>
    </block>
  </view>

  <!-- 单词详情弹窗 -->
  <view class="word-popup-overlay {{showWordPopup ? 'active' : ''}}" bindtap="onCloseWordPopup">
    <view class="word-popup {{showWordPopup ? 'active' : ''}}" catchtap="noop">
      <view wx:if="{{wordLoading}}" class="word-popup-loading">
        <text class="word-popup-loading-text">Loading...</text>
      </view>
      <view wx:elif="{{wordInfo}}" class="word-popup-content">
        <view class="word-popup-header">
          <text class="word-popup-word">{{wordInfo.word}}</text>
          <text class="word-popup-phonetic" wx:if="{{wordInfo.phonetic}}" bindtap="playWordSound">{{wordInfo.phonetic}}</text>
          <view class="word-popup-speaker" bindtap="playWordSound">
            <text class="word-popup-speaker-icon">🔊</text>
          </view>
        </view>
        <text class="word-popup-chinese" wx:if="{{wordInfo.chinese}}">{{wordInfo.chinese}}</text>
        <view class="word-popup-meanings">
          <view class="word-popup-meaning" wx:for="{{wordInfo.meanings}}" wx:key="index">
            <text class="word-popup-pos">{{item.partOfSpeech}}</text>
            <text class="word-popup-def">{{item.definition}}</text>
            <text class="word-popup-example" wx:if="{{item.example}}">"{{item.example}}"</text>
          </view>
        </view>
      </view>
      <view class="word-popup-close" bindtap="onCloseWordPopup">
        <text class="word-popup-close-btn">✕</text>
      </view>
    </view>
  </view>
</view>