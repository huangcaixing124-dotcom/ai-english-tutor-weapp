/* ═══════════════════════════════════════
   主页面样式
   ═══════════════════════════════════════ */

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: transparent;
  overflow: hidden;
  position: relative;
}
.page-container > view:not(.ambient-bg) {
  position: relative;
  z-index: 1;
}

/* 氛围光背景 */
.ambient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  transition: background 1.5s ease;
  animation: ambient-breathe 4s ease-in-out infinite;
}
@keyframes ambient-breathe {
  0%, 100% { opacity: 0.7; }
  50% { opacity: 1; }
}

/* ═══ 顶部标题 ═══ */
.header {
  flex-shrink: 0;
  padding-bottom: 8rpx;
}
.header-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
  color: var(--foreground);
}
.header-subtitle {
  font-size: 24rpx;
  color: var(--foreground-tertiary);
  margin-top: 4rpx;
}

/* ═══ 场景/难度下拉选择器 ═══ */
.selector-section {
  flex-shrink: 0;
  padding: 8rpx 24rpx 4rpx;
}
.selector-row {
  display: flex;
  gap: 16rpx;
}
.picker-selector {
  flex: 1;
}
.picker-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 20rpx;
  background: var(--apple-gray6);
  border-radius: 16rpx;
  border: 1rpx solid var(--apple-gray5);
}
@media (prefers-color-scheme: dark) {
  .picker-label {
    background: #1c1c1e;
    border-color: #3a3a3c;
  }
}
.picker-label-text {
  font-size: 22rpx;
  color: var(--apple-gray);
  font-weight: 500;
}
.picker-value {
  flex: 1;
  font-size: 24rpx;
  color: var(--foreground);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picker-arrow {
  font-size: 16rpx;
  color: var(--apple-gray2);
}

/* ═══ 模式切换 ═══ */
.mode-switch {
  flex-shrink: 0;
  display: flex;
  justify-content: center;
  padding: 4rpx 24rpx 8rpx;
}
.mode-switch-inner {
  display: flex;
  background: var(--apple-gray6);
  border-radius: 24rpx;
  border: 1rpx solid var(--apple-gray5);
  padding: 4rpx;
}
@media (prefers-color-scheme: dark) {
  .mode-switch-inner {
    background: #1c1c1e;
    border-color: #3a3a3c;
  }
}
.mode-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 32rpx;
  border-radius: 20rpx;
  transition: all 0.2s;
}
.mode-tab.active {
  background: var(--apple-gray3);
}
@media (prefers-color-scheme: dark) {
  .mode-tab.active {
    background: #48484a;
  }
}
.mode-tab-icon {
  font-size: 24rpx;
}
.mode-tab-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--foreground-secondary);
}
.mode-tab.active .mode-tab-text {
  color: var(--foreground);
}

/* ═══ 对话展示区 ═══ */
.conversation-section {
  flex: 1;
  overflow-y: auto;
  padding: 0 24rpx;
  -webkit-overflow-scrolling: touch;
}
.conversation-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

/* 气泡组 */
.bubble-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* AI 气泡 */
.bubble-ai {
  display: flex;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  border-bottom-left-radius: 6rpx;
  background: transparent;
}
.bubble-correction {
  border-left: 4rpx solid var(--apple-orange);
}

/* 气泡内容 */
.bubble-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.bubble-label {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
  color: var(--apple-gray);
  text-transform: uppercase;
}
.bubble-label-english {
  color: var(--apple-green);
}
.bubble-label-translate {
  color: var(--apple-blue);
}
.bubble-label-orange {
  color: var(--apple-orange);
}
/* 标签行（English 标签 + 重播按钮） */
.bubble-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 2rpx;
}
.replay-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  background: var(--apple-gray6);
  border: 1rpx solid var(--apple-gray5);
  flex-shrink: 0;
}
@media (prefers-color-scheme: dark) {
  .replay-btn {
    background: #1c1c1e;
    border-color: #3a3a3c;
  }
}
.replay-btn:active {
  opacity: 0.6;
}
.replay-icon {
  font-size: 24rpx;
  line-height: 1;
}
.bubble-text {
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--foreground);
  word-break: break-word;
}
.bubble-text-secondary {
  color: var(--foreground-secondary);
}

/* 用户气泡 */
.bubble-user {
  display: flex;
  justify-content: flex-end;
  margin-left: 80rpx;
}
.bubble-user-text {
  background: var(--apple-blue);
  color: white;
  font-size: 28rpx;
  line-height: 1.5;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  border-bottom-right-radius: 8rpx;
  word-break: break-word;
}

/* ═══ 底部输入区域 ═══ */
.footer {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx 40rpx;
  gap: 12rpx;
  background: transparent;
}

/* 错误提示 */
.error-tip {
  padding: 12rpx 24rpx;
  background: rgba(255, 59, 48, 0.08);
  border-radius: 16rpx;
  font-size: 22rpx;
  color: var(--apple-red);
  max-width: 500rpx;
  text-align: center;
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  padding: 8rpx 8rpx 8rpx 24rpx;
  background: var(--apple-gray6);
  border-radius: 36rpx;
  border: 1rpx solid var(--apple-gray5);
  transition: all 0.2s;
}
@media (prefers-color-scheme: dark) {
  .input-bar {
    background: #1c1c1e;
    border-color: #3a3a3c;
  }
}
.input-bar.disabled {
  opacity: 0.6;
}

.text-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  color: var(--foreground);
  background: transparent;
  border: none;
  outline: none;
}
.input-placeholder {
  color: var(--apple-gray2);
}
@media (prefers-color-scheme: dark) {
  .input-placeholder {
    color: #636366;
  }
}

/* 发送按钮 */
.send-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--apple-gray4);
  flex-shrink: 0;
  transition: all 0.2s;
}
.send-button.active {
  background: var(--apple-blue);
}
.send-icon {
  width: 36rpx;
  height: 36rpx;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
}
.send-icon svg {
  width: 100%;
  height: 100%;
}

/* 语音输入组 */
.voice-input-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  padding: 8rpx 0;
}
.voice-input-group.disabled {
  opacity: 0.6;
}

/* 语音录制按钮 - 动态渐变光球 */
.record-button {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s;
  /* 自然渐变流动 */
  background: linear-gradient(135deg, #007aff, #0055b3, #0066cc, #007aff);
  background-size: 300% 300%;
  animation: gradient-flow 3s ease-in-out infinite;
  box-shadow: 0 8rpx 32rpx rgba(0, 122, 255, 0.35), 0 0 0 0 rgba(0, 122, 255, 0.2), inset 0 -4rpx 12rpx rgba(0,0,0,0.1);
}
.record-button:active {
  transform: scale(0.92);
}
.record-button.recording {
  background: linear-gradient(135deg, #ff3b30, #cc2818, #dd2244, #ff3b30);
  background-size: 300% 300%;
  animation: gradient-flow 1.5s ease-in-out infinite;
  box-shadow: 0 8rpx 32rpx rgba(255, 59, 48, 0.4), 0 0 0 12rpx rgba(255, 59, 48, 0.15), inset 0 -4rpx 12rpx rgba(0,0,0,0.1);
}

@keyframes gradient-flow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
.record-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

/* CSS 麦克风图标 */
.mic-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}
.mic-body {
  width: 26rpx;
  height: 36rpx;
  border-radius: 13rpx;
  background: white;
}
.mic-stem {
  width: 4rpx;
  height: 14rpx;
  background: white;
}
.mic-base {
  width: 22rpx;
  height: 8rpx;
  border: 4rpx solid white;
  border-top: none;
  border-radius: 0 0 11rpx 11rpx;
  margin-top: -2rpx;
}

/* 录制中红色圆点 */
.recording-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}
.recording-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: white;
  animation: rec-dot-pulse 1s ease-in-out infinite;
}
@keyframes rec-dot-pulse {
  0%, 100% { transform: scale(0.8); opacity: 0.8; }
  50% { transform: scale(1.1); opacity: 1; }
}

.record-hint {
  font-size: 24rpx;
  color: var(--apple-gray2);
}

/* ═══ 通话模式 ═══ */
.call-start-area,
.call-active-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  padding: 8rpx 0;
}
.call-start-button {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, #34c759, #28a84d, #30d158, #34c759);
  background-size: 300% 300%;
  animation: gradient-flow 3s ease-in-out infinite;
  box-shadow: 0 8rpx 32rpx rgba(52, 199, 89, 0.35), 0 0 0 0 rgba(52, 199, 89, 0.2), inset 0 -4rpx 12rpx rgba(0,0,0,0.1);
  transition: all 0.3s;
}
.call-start-button:active {
  transform: scale(0.92);
}

/* CSS 电话图标 */
.call-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  transform: rotate(-45deg);
}
.call-icon-handset {
  width: 26rpx;
  height: 32rpx;
  border-radius: 13rpx 13rpx 6rpx 6rpx;
  background: white;
}
.call-icon-base {
  width: 30rpx;
  height: 8rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: white;
  margin-top: -2rpx;
}

.call-end-button {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, #ff3b30, #cc2818, #dd2244, #ff3b30);
  background-size: 300% 300%;
  animation: gradient-flow 1.5s ease-in-out infinite;
  box-shadow: 0 8rpx 32rpx rgba(255, 59, 48, 0.4), 0 0 0 12rpx rgba(255, 59, 48, 0.12), inset 0 -4rpx 12rpx rgba(0,0,0,0.1);
  transition: all 0.3s;
}
.call-end-button:active {
  transform: scale(0.92);
}
.end-square {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  background: white;
}
.call-end-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
.call-status-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--apple-gray);
}
.call-status-label.listening {
  color: #34c759;
  animation: call-pulse 1.5s ease-in-out infinite;
}
.call-status-label.processing {
  color: #ff9500;
}
.call-status-label.speaking {
  color: var(--apple-blue);
}

@keyframes call-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

/* 底部提示 */
.footer-hint {
  font-size: 22rpx;
  color: var(--apple-gray2);
}

/* 动画 */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.slide-up {
  animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* ═══ 可点击单词 ═══ */
.word-hint {
  font-size: 20rpx;
  color: var(--apple-gray2);
  font-weight: 400;
}
.word-container {
  display: inline;
  line-height: 1.8;
}
.word-tappable {
  display: inline;
  color: var(--foreground);
  font-size: 28rpx;
  line-height: 1.8;
  border-bottom: 2rpx dashed var(--apple-gray3);
  padding: 2rpx 0;
}
.word-punct {
  display: inline;
  font-size: 28rpx;
  color: var(--foreground);
  line-height: 1.8;
}

/* ═══ 单词详情弹窗 ═══ */
.word-popup-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.3);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.word-popup-overlay.active {
  opacity: 1;
  pointer-events: auto;
}
.word-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--background);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  max-height: 60vh;
  overflow-y: auto;
}
.word-popup.active {
  transform: translateY(0);
}
.word-popup-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}
.word-popup-loading-text {
  font-size: 28rpx;
  color: var(--apple-gray);
}
.word-popup-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.word-popup-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.word-popup-word {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--foreground);
}
.word-popup-phonetic {
  font-size: 28rpx;
  color: var(--apple-gray);
  font-family: monospace;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}
.word-popup-speaker {
  margin-left: auto;
  padding: 8rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.word-popup-speaker-icon {
  font-size: 36rpx;
}
.word-popup-chinese {
  font-size: 32rpx;
  color: var(--apple-blue);
  font-weight: 500;
}
.word-popup-meanings {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 8rpx;
}
.word-popup-meaning {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.word-popup-pos {
  font-size: 22rpx;
  color: var(--apple-purple);
  font-weight: 600;
  font-style: italic;
}
.word-popup-def {
  font-size: 28rpx;
  color: var(--foreground);
  line-height: 1.5;
}
.word-popup-example {
  font-size: 26rpx;
  color: var(--apple-gray);
  font-style: italic;
  margin-top: 4rpx;
}
.word-popup-close {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}
.word-popup-close-btn {
  font-size: 36rpx;
  color: var(--apple-gray2);
  padding: 8rpx 24rpx;
}

/* ═══ 语音消息气泡 ═══ */
.bubble-user-voice-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: 80rpx;
  margin-right: 24rpx;
}
.bubble-user-voice {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: transparent;
  border-radius: 24rpx;
  border-bottom-right-radius: 8rpx;
  position: relative;
  transition: opacity 0.15s;
}
.bubble-user-voice:active {
  opacity: 0.7;
}
.bubble-ai-voice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: transparent;
  border-radius: 24rpx;
  border-bottom-left-radius: 8rpx;
  padding: 20rpx 28rpx;
  margin-right: 80rpx;
  margin-top: 12rpx;
  min-width: 180rpx;
  max-width: 420rpx;
}

/* AI 加载中气泡 */
.bubble-ai-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border-radius: 24rpx;
  border-bottom-left-radius: 8rpx;
  padding: 24rpx 32rpx;
  margin-right: 80rpx;
  margin-top: 12rpx;
  width: 100rpx;
}
.loading-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--apple-gray3);
  animation: dot-bounce 1.4s ease-in-out infinite;
}
.dot-1 { animation-delay: 0s; }
.dot-2 { animation-delay: 0.2s; }
.dot-3 { animation-delay: 0.4s; }

@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}
.voice-wave-icon {
  width: 60rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.voice-wave-text {
  font-size: 32rpx;
}
.voice-wave-bars {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 40rpx;
}
.wave-bar {
  width: 6rpx;
  border-radius: 3rpx;
  background: white;
  opacity: 0.8;
}
.bubble-user-voice .wave-bar {
  background: var(--apple-blue);
  transform-origin: center;
}
.bubble-user-voice.playing .wave-bar {
  animation: wave-pulse 1s ease-in-out infinite;
}
.bubble-user-voice .wave-bar-1 { animation-delay: 0s; }
.bubble-user-voice .wave-bar-2 { animation-delay: 0.2s; }
.bubble-user-voice .wave-bar-3 { animation-delay: 0.4s; }
.bubble-ai-voice .wave-bar {
  background: var(--apple-blue);
}
.wave-bar-1 { height: 12rpx; }
.wave-bar-2 { height: 28rpx; }
.wave-bar-3 { height: 20rpx; }

@keyframes wave-pulse {
  0%, 100% { transform: scaleY(0.6); }
  50% { transform: scaleY(1.2); }
}
.voice-time {
  font-size: 20rpx;
  color: var(--apple-gray3);
}
.bubble-user-voice-wrap .voice-time {
  color: var(--foreground-secondary);
  flex-shrink: 0;
  font-size: 24rpx;
}