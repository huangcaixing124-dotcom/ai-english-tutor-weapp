/* ═══════════════════════════════════════
   主页面样式
   ═══════════════════════════════════════ */

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--background);
  overflow: hidden;
  position: relative;
}
/* 背景浮动光晕 */
.page-container::before,
.page-container::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  z-index: 0;
  pointer-events: none;
}
.page-container::before {
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(0, 122, 255, 0.08), transparent 70%);
  top: -200rpx;
  right: -200rpx;
  animation: blob-float 8s ease-in-out infinite;
}
.page-container::after {
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(88, 86, 214, 0.06), transparent 70%);
  bottom: -150rpx;
  left: -150rpx;
  animation: blob-float 10s ease-in-out infinite reverse;
}
@media (prefers-color-scheme: dark) {
  .page-container::before {
    background: radial-gradient(circle, rgba(0, 122, 255, 0.12), transparent 70%);
  }
  .page-container::after {
    background: radial-gradient(circle, rgba(88, 86, 214, 0.1), transparent 70%);
  }
}
@keyframes blob-float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(30rpx, -40rpx) scale(1.1); }
  66% { transform: translate(-20rpx, 20rpx) scale(0.9); }
}
.page-container > view {
  position: relative;
  z-index: 1;
}

/* ═══ 顶部标题 ═══ */
.header {
  flex-shrink: 0;
  padding-bottom: 8rpx;
}
.header-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
  color: var(--foreground);
}
.header-subtitle {
  font-size: 24rpx;
  color: var(--foreground-tertiary);
  margin-top: 4rpx;
}

/* ═══ 场景/难度下拉选择器 ═══ */
.selector-section {
  flex-shrink: 0;
  padding: 8rpx 24rpx 4rpx;
}
.selector-row {
  display: flex;
  gap: 16rpx;
}
.picker-selector {
  flex: 1;
}
.picker-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 20rpx;
  background: var(--apple-gray6);
  border-radius: 16rpx;
  border: 1rpx solid var(--apple-gray5);
}
@media (prefers-color-scheme: dark) {
  .picker-label {
    background: #1c1c1e;
    border-color: #3a3a3c;
  }
}
.picker-label-text {
  font-size: 22rpx;
  color: var(--apple-gray);
  font-weight: 500;
}
.picker-value {
  flex: 1;
  font-size: 24rpx;
  color: var(--foreground);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picker-arrow {
  font-size: 16rpx;
  color: var(--apple-gray2);
}

/* ═══ 模式切换 ═══ */
.mode-switch {
  flex-shrink: 0;
  display: flex;
  justify-content: center;
  padding: 4rpx 24rpx 8rpx;
}
.mode-switch-inner {
  display: flex;
  background: var(--apple-gray6);
  border-radius: 24rpx;
  border: 1rpx solid var(--apple-gray5);
  padding: 4rpx;
}
@media (prefers-color-scheme: dark) {
  .mode-switch-inner {
    background: #1c1c1e;
    border-color: #3a3a3c;
  }
}
.mode-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 32rpx;
  border-radius: 20rpx;
  transition: all 0.2s;
}
.mode-tab.active {
  background: var(--apple-gray3);
}
@media (prefers-color-scheme: dark) {
  .mode-tab.active {
    background: #48484a;
  }
}
.mode-tab-icon {
  font-size: 24rpx;
}
.mode-tab-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--foreground-secondary);
}
.mode-tab.active .mode-tab-text {
  color: var(--foreground);
}

/* ═══ 角色区域 ═══ */
.character-section {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

/* 声波动画（AILO 风格交错波浪） */
.voice-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 48rpx;
  opacity: 0;
  transition: opacity 0.3s;
}
.voice-indicator.active {
  opacity: 1;
}
.voice-bar {
  width: 5rpx;
  border-radius: 3rpx;
  background: var(--apple-gray3);
  animation: wv 0.9s ease-in-out infinite;
}
.voice-bar-green {
  background: var(--apple-green);
}
.voice-bar:nth-child(1) { animation-delay: 0s; }
.voice-bar:nth-child(2) { animation-delay: 0.1s; }
.voice-bar:nth-child(3) { animation-delay: 0.2s; }
.voice-bar:nth-child(4) { animation-delay: 0.3s; }
.voice-bar:nth-child(5) { animation-delay: 0.4s; }
.voice-bar:nth-child(6) { animation-delay: 0.3s; }
.voice-bar:nth-child(7) { animation-delay: 0.2s; }
.voice-bar:nth-child(8) { animation-delay: 0.1s; }
.voice-bar:nth-child(9) { animation-delay: 0.05s; }
.voice-bar:nth-child(10) { animation-delay: 0.15s; }

@keyframes wv {
  0%, 100% { height: 8rpx; opacity: 0.4; }
  50% { height: 40rpx; opacity: 1; }
}

/* ═══ 对话展示区 ═══ */
.conversation-section {
  flex: 1;
  overflow-y: auto;
  padding: 0 24rpx;
  -webkit-overflow-scrolling: touch;
}
.conversation-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

/* 气泡组 */
.bubble-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* AI 气泡 */
.bubble-ai {
  display: flex;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  border-bottom-left-radius: 6rpx;
  background: var(--frosted-bg);
  border: 1rpx solid var(--frosted-border);
  box-shadow: var(--frosted-shadow);
}
.bubble-correction {
  border-left: 4rpx solid var(--apple-orange);
}

/* 气泡内容 */
.bubble-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.bubble-label {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
  color: var(--apple-gray);
  text-transform: uppercase;
}
.bubble-label-english {
  color: var(--apple-green);
}
.bubble-label-translate {
  color: var(--apple-blue);
}
.bubble-label-orange {
  color: var(--apple-orange);
}
/* 标签行（English 标签 + 重播按钮） */
.bubble-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 2rpx;
}
.replay-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  background: var(--apple-gray6);
  border: 1rpx solid var(--apple-gray5);
  flex-shrink: 0;
}
@media (prefers-color-scheme: dark) {
  .replay-btn {
    background: #1c1c1e;
    border-color: #3a3a3c;
  }
}
.replay-btn:active {
  opacity: 0.6;
}
.replay-icon {
  font-size: 24rpx;
  line-height: 1;
}
.bubble-text {
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--foreground);
  word-break: break-word;
}
.bubble-text-secondary {
  color: var(--foreground-secondary);
}

/* 用户气泡 */
.bubble-user {
  display: flex;
  justify-content: flex-end;
  margin-left: 80rpx;
}
.bubble-user-text {
  background: var(--apple-blue);
  color: white;
  font-size: 28rpx;
  line-height: 1.5;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  border-bottom-right-radius: 8rpx;
  word-break: break-word;
}

/* ═══ 底部输入区域 ═══ */
.footer {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 24rpx 40rpx;
  gap: 12rpx;
}

/* 错误提示 */
.error-tip {
  padding: 12rpx 24rpx;
  background: rgba(255, 59, 48, 0.08);
  border-radius: 16rpx;
  font-size: 22rpx;
  color: var(--apple-red);
  max-width: 500rpx;
  text-align: center;
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  padding: 8rpx 8rpx 8rpx 24rpx;
  background: var(--apple-gray6);
  border-radius: 36rpx;
  border: 1rpx solid var(--apple-gray5);
  transition: all 0.2s;
}
@media (prefers-color-scheme: dark) {
  .input-bar {
    background: #1c1c1e;
    border-color: #3a3a3c;
  }
}
.input-bar.disabled {
  opacity: 0.6;
}

.text-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  color: var(--foreground);
  background: transparent;
  border: none;
  outline: none;
}
.input-placeholder {
  color: var(--apple-gray2);
}
@media (prefers-color-scheme: dark) {
  .input-placeholder {
    color: #636366;
  }
}

/* 发送按钮 */
.send-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--apple-gray4);
  flex-shrink: 0;
  transition: all 0.2s;
}
.send-button.active {
  background: var(--apple-blue);
}
.send-icon {
  width: 36rpx;
  height: 36rpx;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
}
.send-icon svg {
  width: 100%;
  height: 100%;
}

/* 语音输入组 */
.voice-input-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  padding: 8rpx 0;
}
.voice-input-group.disabled {
  opacity: 0.6;
}

/* 语音录制按钮 */
.record-button {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s;
  background: linear-gradient(135deg, #007aff, #5856d6);
  box-shadow: 0 8rpx 32rpx rgba(0, 122, 255, 0.35), 0 0 0 0 rgba(0, 122, 255, 0.2);
}
.record-button:active {
  transform: scale(0.92);
}
.record-button.recording {
  background: linear-gradient(135deg, #ff3b30, #ff9500);
  box-shadow: 0 8rpx 32rpx rgba(255, 59, 48, 0.4), 0 0 0 12rpx rgba(255, 59, 48, 0.15);
  animation: record-pulse 1.2s ease-in-out infinite;
}
.record-icon {
  font-size: 52rpx;
  color: white;
}
.record-hint {
  font-size: 24rpx;
  color: var(--apple-gray2);
}

@keyframes record-pulse {
  0%, 100% { box-shadow: 0 8rpx 32rpx rgba(255, 59, 48, 0.4), 0 0 0 12rpx rgba(255, 59, 48, 0.15); }
  50% { box-shadow: 0 8rpx 32rpx rgba(255, 59, 48, 0.4), 0 0 0 24rpx rgba(255, 59, 48, 0.05); }
}

/* ═══ 通话模式 ═══ */
.call-start-area,
.call-active-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  padding: 8rpx 0;
}
.call-start-button {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, #34c759, #00c7be);
  box-shadow: 0 8rpx 32rpx rgba(52, 199, 89, 0.35), 0 0 0 0 rgba(52, 199, 89, 0.2);
  transition: all 0.3s;
}
.call-start-button:active {
  transform: scale(0.92);
}
.call-start-icon {
  font-size: 52rpx;
  color: white;
}
.call-end-button {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, #ff3b30, #ff9500);
  box-shadow: 0 8rpx 32rpx rgba(255, 59, 48, 0.4), 0 0 0 12rpx rgba(255, 59, 48, 0.12);
  animation: call-glow 1.5s ease-in-out infinite;
  transition: all 0.3s;
}
.call-end-button:active {
  transform: scale(0.92);
}
.call-end-icon {
  font-size: 44rpx;
  color: white;
}
.call-status-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--apple-gray);
}
.call-status-label.listening {
  color: #34c759;
  animation: call-pulse 1.5s ease-in-out infinite;
}
.call-status-label.processing {
  color: #ff9500;
}
.call-status-label.speaking {
  color: var(--apple-blue);
}

@keyframes call-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}
@keyframes call-glow {
  0%, 100% { box-shadow: 0 8rpx 32rpx rgba(255, 59, 48, 0.4), 0 0 0 12rpx rgba(255, 59, 48, 0.12); }
  50% { box-shadow: 0 8rpx 32rpx rgba(255, 59, 48, 0.4), 0 0 0 24rpx rgba(255, 59, 48, 0.04); }
}

/* 底部提示 */
.footer-hint {
  font-size: 22rpx;
  color: var(--apple-gray2);
}

/* 动画 */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.slide-up {
  animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* ═══ 可点击单词 ═══ */
.word-hint {
  font-size: 20rpx;
  color: var(--apple-gray2);
  font-weight: 400;
}
.word-container {
  display: inline;
  line-height: 1.8;
}
.word-tappable {
  display: inline;
  color: var(--foreground);
  font-size: 28rpx;
  line-height: 1.8;
  border-bottom: 2rpx dashed var(--apple-gray3);
  padding: 2rpx 0;
}
.word-punct {
  display: inline;
  font-size: 28rpx;
  color: var(--foreground);
  line-height: 1.8;
}

/* ═══ 单词详情弹窗 ═══ */
.word-popup-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.3);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.word-popup-overlay.active {
  opacity: 1;
  pointer-events: auto;
}
.word-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--background);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  max-height: 60vh;
  overflow-y: auto;
}
.word-popup.active {
  transform: translateY(0);
}
.word-popup-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}
.word-popup-loading-text {
  font-size: 28rpx;
  color: var(--apple-gray);
}
.word-popup-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.word-popup-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.word-popup-word {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--foreground);
}
.word-popup-phonetic {
  font-size: 28rpx;
  color: var(--apple-gray);
  font-family: monospace;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}
.word-popup-speaker {
  margin-left: auto;
  padding: 8rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.word-popup-speaker-icon {
  font-size: 36rpx;
}
.word-popup-chinese {
  font-size: 32rpx;
  color: var(--apple-blue);
  font-weight: 500;
}
.word-popup-meanings {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 8rpx;
}
.word-popup-meaning {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.word-popup-pos {
  font-size: 22rpx;
  color: var(--apple-purple);
  font-weight: 600;
  font-style: italic;
}
.word-popup-def {
  font-size: 28rpx;
  color: var(--foreground);
  line-height: 1.5;
}
.word-popup-example {
  font-size: 26rpx;
  color: var(--apple-gray);
  font-style: italic;
  margin-top: 4rpx;
}
.word-popup-close {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}
.word-popup-close-btn {
  font-size: 36rpx;
  color: var(--apple-gray2);
  padding: 8rpx 24rpx;
}

/* ═══ 语音消息气泡 ═══ */
.bubble-user-voice-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: 80rpx;
  margin-right: 24rpx;
}
.bubble-user-voice {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: var(--frosted-bg);
  border: 1rpx solid var(--frosted-border);
  box-shadow: var(--frosted-shadow);
  border-radius: 24rpx;
  border-bottom-right-radius: 8rpx;
  position: relative;
  transition: opacity 0.15s;
}
.bubble-user-voice:active {
  opacity: 0.7;
}
.bubble-user-voice::after {
  content: '';
  position: absolute;
  right: -12rpx;
  top: 50%;
  margin-top: -8rpx;
  border: 8rpx solid transparent;
  border-left: 12rpx solid var(--frosted-bg);
  border-right: 0;
}
.bubble-ai-voice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--apple-gray6);
  border-radius: 24rpx;
  border-bottom-left-radius: 8rpx;
  padding: 20rpx 28rpx;
  margin-right: 80rpx;
  margin-top: 12rpx;
  min-width: 180rpx;
  max-width: 420rpx;
}
@media (prefers-color-scheme: dark) {
  .bubble-ai-voice {
    background: #1c1c1e;
  }
}

/* AI 加载中气泡 */
.bubble-ai-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--apple-gray6);
  border-radius: 24rpx;
  border-bottom-left-radius: 8rpx;
  padding: 24rpx 32rpx;
  margin-right: 80rpx;
  margin-top: 12rpx;
  width: 100rpx;
}
@media (prefers-color-scheme: dark) {
  .bubble-ai-loading {
    background: #1c1c1e;
  }
}
.loading-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--apple-gray3);
  animation: dot-bounce 1.4s ease-in-out infinite;
}
.dot-1 { animation-delay: 0s; }
.dot-2 { animation-delay: 0.2s; }
.dot-3 { animation-delay: 0.4s; }

@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}
.voice-wave-icon {
  width: 60rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.voice-wave-text {
  font-size: 32rpx;
}
.voice-wave-bars {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 40rpx;
}
.wave-bar {
  width: 6rpx;
  border-radius: 3rpx;
  background: white;
  opacity: 0.8;
}
.bubble-user-voice .wave-bar {
  background: var(--apple-blue);
  transform-origin: center;
}
.bubble-user-voice.playing .wave-bar {
  animation: wave-pulse 1s ease-in-out infinite;
}
.bubble-user-voice .wave-bar-1 { animation-delay: 0s; }
.bubble-user-voice .wave-bar-2 { animation-delay: 0.2s; }
.bubble-user-voice .wave-bar-3 { animation-delay: 0.4s; }
.bubble-ai-voice .wave-bar {
  background: var(--apple-blue);
}
.wave-bar-1 { height: 12rpx; }
.wave-bar-2 { height: 28rpx; }
.wave-bar-3 { height: 20rpx; }

@keyframes wave-pulse {
  0%, 100% { transform: scaleY(0.6); }
  50% { transform: scaleY(1.2); }
}
.voice-time {
